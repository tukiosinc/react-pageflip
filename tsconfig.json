{
    "compilerOptions": {
        "strict": false,
        "noUncheckedSideEffectImports": false,
        "declaration": true,
        "declarationDir": "build",
        "module": "esnext",
        "target": "es2015",
        "lib": ["es2017", "dom"],
        "sourceMap": true,
        "jsx": "react",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "rootDir": "./src"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build", "src/**/*.test.tsx"]
}
